# Copy to /opt/carbontrack/.env on the server and fill in real values. Never commit the real file.
GHCR_OWNER=your-github-username-lowercase
DB_USERNAME=carbontrack
DB_PASSWORD=change-me
JWT_SECRET=replace-with-64-plus-random-characters
JWT_EXPIRY_MINUTES=1440
APP_SEED_ENABLED=true
JAVA_TOOL_OPTIONS=-Xmx512m
# Leave blank for rule-based assistant answers
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
